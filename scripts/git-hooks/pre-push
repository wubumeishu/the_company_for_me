#!/bin/sh
# 第二道防线：pre-push —— 拒绝"无 PR 关联/非门禁通过"的 push（防人绕过引擎直推主干）
# 引擎权威层（git_policy.py）判定 merge 才放行；这里是人肉护栏：
#   · 推 main 必须带 -m 关联 PR 号，或 CI 已绿（本地无法查 CI 时：要求 push 到 PR 头分支）
# 安装：bash scripts/git-hooks/install.sh（软链到 .git/hooks）
branch="$4"
case "$branch" in
  main|master)
    # 允许：GitHub PR merge（remote ref 带 refs/pull/）或带 PR 关联标记的环境变量
    if [ "$COMPANY_PR" ] || echo "$*" | grep -q "refs/pull/"; then
      exit 0
    fi
    echo "✗ pre-push 护栏：禁止直接推 main（必须经 PR + 门禁，见 git_policy.py 引擎权威层）"
    echo "  如确需强制（灾难恢复），用 COMPANY_PR=1 显式声明责任"
    exit 1
    ;;
esac
exit 0
